# ─── Core (required) ────────────────────────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=000000000000000000
DISCORD_GUILD_ID=000000000000000000

# ─── Upload notifications ───────────────────────────────────────────────────
# How often (seconds) to poll every configured account. 300 = 5 min is polite.
POLL_INTERVAL_SECONDS=300

# YouTube needs no key — it uses the public RSS feed for a channel ID.
# Optional: an API key unlocks richer data (duration, view count, live status).
YOUTUBE_API_KEY=

# X / Twitter — Bearer token from developer.x.com (v2 API).
# Leave empty to fall back to the Nitter RSS mirror configured below.
X_BEARER_TOKEN=
NITTER_BASE_URL=https://nitter.net

# TikTok + Instagram have no free public feed. Point this at an RSSHub
# instance (self-host it: https://docs.rsshub.app/install/) or a paid bridge.
RSSHUB_BASE_URL=https://rsshub.app

# Twitch (live-on notifications) — dev.twitch.tv application credentials
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── Automod (optional) ─────────────────────────────────────────────────────
# Automod's content rules (invites, links, blocked words, shouting, repeats)
# need the Message Content intent. Turn it on in BOTH places or leave it off in
# both: Developer Portal → Bot → Privileged Gateway Intents → Message Content,
# and this variable. Requesting an intent you haven't enabled makes login fail.
# Everything else — levels, starboard, giveaways, roles — works without it.
ENABLE_MESSAGE_CONTENT=false

# ─── Dashboard (optional) ───────────────────────────────────────────────────
# Note: do NOT set PORT yourself on Railway, Render or Fly — they inject it, and
# overriding it makes the platform route to a port nothing is listening on
# ("Application failed to respond"). Only set it for local development.
# A web UI for everything below, so you never edit config.json by hand.
DASHBOARD_ENABLED=true

# Developer Portal → OAuth2 → Client Secret. Without it the dashboard won't start.
DISCORD_CLIENT_SECRET=

# The dashboard's own public URL, no trailing slash. On Railway this is filled
# in automatically once you generate a domain. Add "<this URL>/callback" to
# Developer Portal → OAuth2 → Redirects, or login fails.
DASHBOARD_URL=

# Signs the login cookie. Any long random string — changing it signs everyone out.
SESSION_SECRET=

# ─── Behaviour ──────────────────────────────────────────────────────────────
# On first run, mark everything currently in a feed as "already seen" so the
# bot doesn't dump the last 15 uploads into the channel. Strongly recommended.
SEED_ON_FIRST_RUN=true
LOG_LEVEL=info

# Register slash commands automatically on startup. Leave this on unless you
# have a terminal and prefer running `npm run deploy` yourself.
AUTO_DEPLOY_COMMANDS=true

# Where the "already announced" store is written. On a host with a mounted
# volume, point this at the mount path (Railway: /app/data) so a redeploy
# doesn't make the bot forget and re-announce your last uploads.
DATA_DIR=data
